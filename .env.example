NODE_ENV=development
SERVER_PORT=4000
CLIENT_PORT=3000
DATABASE_URL=postgresql://dance_app:replace-me@localhost:5432/dance_studio
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dance_studio
DB_USER=dance_app
DB_PASSWORD=replace-me
JWT_SECRET=replace-with-at-least-32-random-characters
PII_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000
OPENROUTER_API_KEY=
PAYMENT_PROVIDER_URL=
MESSAGING_PROVIDER_URL=
ATTENDANCE_PROVIDER_URL=
MEDIA_PROVIDER_URL=
